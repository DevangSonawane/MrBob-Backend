// Home Services Platform — Prisma schema
// Modular monolith on a single Postgres instance. Tables are grouped by
// module (User, Professional, Booking, Payment, AMC, ...) with comments
// marking ownership so a future extraction into its own service/schema
// (see architecture doc: "Scaling: Monolith to Microservices") is mechanical.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users module
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  PROFESSIONAL
  ADMIN
  SUPER_ADMIN // everything ADMIN can do, plus final vendor approval and managing other admins
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id               String    @id @default(uuid())
  name             String
  phone            String?   @unique // set via phone/OTP signup, or added later during onboarding
  email            String?   @unique // set via email/password signup
  role             UserRole  @default(CUSTOMER)
  cityId           String?
  address          String? // one-line copy of the default address (see Address); kept for older clients
  gender           Gender?
  dateOfBirth      DateTime? @db.Date
  profilePhotoKey  String? // storage key; served through GET /users/{id}/photo
  profilePhotoMime String?
  passwordHash     String? // present only for email/password accounts; OTP-only accounts have none
  isOnboarded      Boolean   @default(false) // true once the role-specific onboarding flow is completed
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  // Set when the account is deleted. The row is kept (bookings and reviews
  // still point at it) but its personal details are wiped.
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  city                  City?                   @relation(fields: [cityId], references: [id])
  professional          Professional?
  bookings              Booking[]               @relation("CustomerBookings")
  amcSubscriptions      AMCSubscription[]
  reviews               Review[]
  addresses             Address[]
  bookingEvents         BookingEvent[]          @relation("BookingEventActor")
  reviewedProfessionals Professional[]          @relation("ProfessionalReviewer")
  verifiedDocuments     ProfessionalDocument[]  @relation("DocumentVerifier")
  onboardingEvents      VendorOnboardingEvent[] @relation("OnboardingEventActor")

  @@index([cityId])
  @@map("users")
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

// A customer's saved addresses. Exactly one per user is the default; the
// user's cityId and one-line `address` mirror it.
model Address {
  id           String       @id @default(uuid())
  userId       String
  label        AddressLabel @default(HOME)
  contactName  String? // who to ask for at this address, if not the account holder
  contactPhone String?
  line1        String
  line2        String?
  landmark     String?
  cityId       String? // always set by the app's own forms; only empty when saved with onboarding validation off
  zoneId       String?
  state        String
  pincode      String
  latitude     Decimal?     @db.Decimal(9, 6)
  longitude    Decimal?     @db.Decimal(9, 6)
  isDefault    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  city     City?     @relation(fields: [cityId], references: [id])
  zone     Zone?     @relation(fields: [zoneId], references: [id])
  bookings Booking[]

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Professionals module
// ---------------------------------------------------------------------------

enum KycStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
}

// Where a vendor is in the onboarding flow. `kycStatus` above is kept in step
// with this (see vendorOnboarding.service.js) because dispatch and the
// dashboard only care about the coarse verified / not-verified answer.
enum VendorOnboardingStatus {
  DRAFT // vendor is still filling in the steps
  SUBMITTED // waiting for Aadhaar/PAN verification
  PENDING_APPROVAL // documents verified, waiting for a super admin
  CHANGES_REQUESTED // sent back to the vendor to fix something and resubmit
  APPROVED
  REJECTED
}

model Professional {
  id         String    @id @default(uuid())
  userId     String    @unique
  categories String[] // ServiceCategory ids this professional serves
  kycStatus  KycStatus @default(PENDING)
  rating     Decimal   @default(0) @db.Decimal(3, 2)
  homeZoneId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Onboarding: personal details (name, phone, email and city live on User)
  onboardingStatus      VendorOnboardingStatus @default(DRAFT)
  dateOfBirth           DateTime?              @db.Date
  gender                Gender?
  alternatePhone        String?
  addressLine1          String?
  addressLine2          String?
  landmark              String?
  pincode               String?
  state                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  experienceYears       Int?

  // Onboarding: face photo, shown to customers once the vendor is approved
  profilePhotoKey  String?
  profilePhotoMime String?

  // Onboarding: review outcome
  submittedAt  DateTime?
  reviewedAt   DateTime? // when a super admin approved or rejected
  reviewedById String?
  reviewNote   String? // reason for rejection / requested changes, shown to the vendor

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeZone         Zone?                   @relation(fields: [homeZoneId], references: [id])
  reviewedBy       User?                   @relation("ProfessionalReviewer", fields: [reviewedById], references: [id])
  bookings         Booking[]               @relation("ProfessionalBookings")
  documents        ProfessionalDocument[]
  onboardingEvents VendorOnboardingEvent[]

  @@index([homeZoneId])
  @@index([onboardingStatus])
  @@map("professionals")
}

enum KycDocumentType {
  AADHAAR
  PAN
  BANK_ACCOUNT // payout account; the "front" file is a cancelled cheque or passbook page
}

enum BankAccountType {
  SAVINGS
  CURRENT
}

enum KycDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

// One row per document type per vendor (Aadhaar, PAN, payout bank account). The document number is never stored
// in plaintext: `numberEncrypted` is AES-256-GCM (see utils/kycCrypto.js),
// `numberHash` is a keyed hash used only to stop the same Aadhaar/PAN being
// registered on two accounts, and `numberLast4` is what vendors are shown.
model ProfessionalDocument {
  id              String          @id @default(uuid())
  professionalId  String
  type            KycDocumentType
  numberEncrypted String
  numberHash      String
  numberLast4     String
  nameOnDocument  String?
  frontFileKey    String
  frontFileMime   String
  backFileKey     String?
  backFileMime    String?

  // BANK_ACCOUNT only (number* above hold the account number, nameOnDocument the account holder)
  ifsc        String?
  bankName    String?
  branchName  String?
  accountType BankAccountType?
  upiId       String?

  status             KycDocumentStatus @default(PENDING)
  rejectionReason    String?
  // 'MANUAL' when an admin checked it; the provider's name once an automated check is wired in.
  verificationSource String?
  verificationRef    String? // provider's reference/transaction id, if any
  verifiedById       String?
  verifiedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  verifiedBy   User?        @relation("DocumentVerifier", fields: [verifiedById], references: [id])

  @@unique([professionalId, type])
  @@unique([type, numberHash])
  @@map("professional_documents")
}

enum VendorOnboardingAction {
  SUBMITTED
  RESUBMITTED
  DOCUMENT_VERIFIED
  DOCUMENT_REJECTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  REOPENED
}

// Append-only audit trail of everything that happened to an application.
model VendorOnboardingEvent {
  id             String                  @id @default(uuid())
  professionalId String
  actorId        String? // null when the system (e.g. an automated verification) did it
  action         VendorOnboardingAction
  documentType   KycDocumentType?
  fromStatus     VendorOnboardingStatus?
  toStatus       VendorOnboardingStatus?
  note           String?
  createdAt      DateTime                @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  actor        User?        @relation("OnboardingEventActor", fields: [actorId], references: [id])

  @@index([professionalId, createdAt])
  @@map("vendor_onboarding_events")
}

// ---------------------------------------------------------------------------
// Service catalogue
// ---------------------------------------------------------------------------

enum ServiceTier {
  REPAIR
  RENOVATION
  RECURRING
}

model ServiceCategory {
  id        String      @id @default(uuid())
  name      String
  tier      ServiceTier
  basePrice Decimal     @db.Decimal(10, 2)
  // Storage key and type of the picture shown for this service; served from
  // GET /categories/:id/image.
  imageKey  String?
  imageMime String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  bookings Booking[]

  @@map("service_categories")
}

// ---------------------------------------------------------------------------
// Bookings / Dispatch module
// ---------------------------------------------------------------------------

enum BookingStatus {
  AWAITING_PAYMENT // created with online payment chosen; not dispatched until paid
  PENDING // confirmed, waiting for a professional
  MATCHING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMode {
  ONLINE // paid up front through the payment gateway
  PAY_AFTER_SERVICE // collected by the professional once the job is done
}

// Who did something to a booking.
enum BookingActor {
  CUSTOMER
  PROFESSIONAL
  ADMIN
  SYSTEM
}

model Booking {
  id             String        @id @default(uuid())
  // Human-friendly reference shown to customers and support as BK-000123.
  sequence       Int           @unique @default(autoincrement())
  customerId     String
  professionalId String?
  categoryId     String
  status         BookingStatus @default(PENDING)
  scheduledAt    DateTime?
  description    String? // the customer's description of the problem
  paymentMode    PaymentMode   @default(PAY_AFTER_SERVICE)
  price          Decimal?      @db.Decimal(10, 2)

  // Where the job is. Copied from the customer's saved address when the
  // booking is made, so later edits to (or deletion of) that address never
  // change where a booked job takes place.
  address      String // the full address on one line
  addressId    String? // the saved address it came from, if that still exists
  cityId       String?
  zoneId       String?
  pincode      String?
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  contactName  String?
  contactPhone String?

  // Milestones
  assignedAt         DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelledBy        BookingActor?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer     User            @relation("CustomerBookings", fields: [customerId], references: [id])
  professional Professional?   @relation("ProfessionalBookings", fields: [professionalId], references: [id])
  category     ServiceCategory @relation(fields: [categoryId], references: [id])
  savedAddress Address?        @relation(fields: [addressId], references: [id], onDelete: SetNull)
  city         City?           @relation(fields: [cityId], references: [id])
  zone         Zone?           @relation(fields: [zoneId], references: [id])
  payment      Payment?
  review       Review?
  partnerId    String?
  partner      Partner?        @relation(fields: [partnerId], references: [id])
  events       BookingEvent[]

  @@index([customerId])
  @@index([professionalId])
  @@index([status])
  @@index([scheduledAt])
  @@index([cityId])
  @@map("bookings")
}

enum BookingEventType {
  CREATED
  PAYMENT_RECEIVED
  STATUS_CHANGED
  ASSIGNED
  RESCHEDULED
  CANCELLED
  PAYMENT_COLLECTED
  REFUNDED
}

// Append-only timeline of everything that happened to a booking.
model BookingEvent {
  id         String           @id @default(uuid())
  bookingId  String
  type       BookingEventType
  actorId    String? // null for SYSTEM (e.g. the payment gateway's webhook)
  actorRole  BookingActor
  fromStatus BookingStatus?
  toStatus   BookingStatus?
  note       String?
  createdAt  DateTime         @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User?   @relation("BookingEventActor", fields: [actorId], references: [id])

  @@index([bookingId, createdAt])
  @@map("booking_events")
}

// ---------------------------------------------------------------------------
// AMC module
// ---------------------------------------------------------------------------

enum AMCStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model AMCSubscription {
  id          String    @id @default(uuid())
  customerId  String
  plan        String
  startDate   DateTime
  renewalDate DateTime
  status      AMCStatus @default(ACTIVE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer User      @relation(fields: [customerId], references: [id])
  payments Payment[]

  @@index([customerId])
  @@map("amc_subscriptions")
}

// ---------------------------------------------------------------------------
// Payments module
// ---------------------------------------------------------------------------

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REFUND_PENDING // a paid booking was cancelled; the money has not gone back yet
  REFUNDED
}

model Payment {
  id               String        @id @default(uuid())
  bookingId        String?       @unique
  subscriptionId   String?
  amount           Decimal       @db.Decimal(10, 2)
  method           String? // upi, card, netbanking, wallet...
  gatewayRef       String? // razorpay order/payment id
  gatewayPaymentId String? // razorpay payment id, once paid
  paidAt           DateTime?
  refundedAt       DateTime?
  refundReference  String? // gateway refund id, or a note on how it was refunded
  status           PaymentStatus @default(CREATED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  booking      Booking?         @relation(fields: [bookingId], references: [id])
  subscription AMCSubscription? @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Reviews module
// ---------------------------------------------------------------------------

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Zones module
// ---------------------------------------------------------------------------

enum CityTier {
  TIER_1
  TIER_2
}

model City {
  id        String   @id @default(uuid())
  name      String
  tier      CityTier
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  zones     Zone[]
  users     User[]
  partners  Partner[]
  addresses Address[]
  bookings  Booking[]

  @@map("cities")
}

model Zone {
  id        String   @id @default(uuid())
  cityId    String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  city          City           @relation(fields: [cityId], references: [id])
  professionals Professional[]
  addresses     Address[]
  bookings      Booking[]

  @@index([cityId])
  @@map("zones")
}

// ---------------------------------------------------------------------------
// Partners module
// ---------------------------------------------------------------------------

enum PartnerType {
  BUILDER
  RWA
}

model Partner {
  id        String      @id @default(uuid())
  type      PartnerType
  name      String
  cityId    String
  contact   String?
  createdAt DateTime    @default(now())

  city     City      @relation(fields: [cityId], references: [id])
  bookings Booking[]

  @@index([cityId])
  @@map("partners")
}
