// Home Services Platform — Prisma schema
// Modular monolith on a single Postgres instance. Tables are grouped by
// module (User, Professional, Booking, Payment, AMC, ...) with comments
// marking ownership so a future extraction into its own service/schema
// (see architecture doc: "Scaling: Monolith to Microservices") is mechanical.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users module
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  PROFESSIONAL
  ADMIN
  SUPER_ADMIN // everything ADMIN can do, plus final vendor approval and managing other admins
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id               String    @id @default(uuid())
  name             String
  phone            String?   @unique // set via phone/OTP signup, or added later during onboarding
  email            String?   @unique // set via email/password signup
  role             UserRole  @default(CUSTOMER)
  cityId           String?
  address          String? // one-line copy of the default address (see Address); kept for older clients
  gender           Gender?
  dateOfBirth      DateTime? @db.Date
  profilePhotoKey  String? // storage key; served through GET /users/{id}/photo
  profilePhotoMime String?
  passwordHash     String? // present only for email/password accounts; OTP-only accounts have none
  isOnboarded      Boolean   @default(false) // true once the role-specific onboarding flow is completed
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  // Set when the account is deleted. The row is kept (bookings and reviews
  // still point at it) but its personal details are wiped.
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  city                  City?                   @relation(fields: [cityId], references: [id])
  professional          Professional?
  bookings              Booking[]               @relation("CustomerBookings")
  amcSubscriptions      AMCSubscription[]
  reviews               Review[]
  addresses             Address[]
  bookingEvents         BookingEvent[]          @relation("BookingEventActor")
  reviewedProfessionals Professional[]          @relation("ProfessionalReviewer")
  verifiedDocuments     ProfessionalDocument[]  @relation("DocumentVerifier")
  onboardingEvents      VendorOnboardingEvent[] @relation("OnboardingEventActor")
  disputes              Dispute[]               @relation("DisputeRaiser")
  assignedDisputes      Dispute[]               @relation("DisputeAssignee")
  disputeMessages       DisputeMessage[]

  @@index([cityId])
  @@map("users")
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

// A customer's saved addresses. Exactly one per user is the default; the
// user's cityId and one-line `address` mirror it.
model Address {
  id           String       @id @default(uuid())
  userId       String
  label        AddressLabel @default(HOME)
  contactName  String? // who to ask for at this address, if not the account holder
  contactPhone String?
  line1        String
  line2        String?
  landmark     String?
  cityId       String? // always set by the app's own forms; only empty when saved with onboarding validation off
  zoneId       String?
  state        String
  pincode      String
  latitude     Decimal?     @db.Decimal(9, 6)
  longitude    Decimal?     @db.Decimal(9, 6)
  isDefault    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  city     City?     @relation(fields: [cityId], references: [id])
  zone     Zone?     @relation(fields: [zoneId], references: [id])
  bookings Booking[]

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Professionals module
// ---------------------------------------------------------------------------

enum KycStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
}

// Where a vendor is in the onboarding flow. `kycStatus` above is kept in step
// with this (see vendorOnboarding.service.js) because dispatch and the
// dashboard only care about the coarse verified / not-verified answer.
enum VendorOnboardingStatus {
  DRAFT // vendor is still filling in the steps
  SUBMITTED // waiting for Aadhaar/PAN verification
  PENDING_APPROVAL // documents verified, waiting for a super admin
  CHANGES_REQUESTED // sent back to the vendor to fix something and resubmit
  APPROVED
  REJECTED
}

model Professional {
  id         String    @id @default(uuid())
  userId     String    @unique
  categories String[] // ServiceCategory ids this professional serves
  kycStatus  KycStatus @default(PENDING)
  rating     Decimal   @default(0) @db.Decimal(3, 2)

  // Payout terms for this vendor; null = the platform default (PayoutSettings).
  commissionPercent         Decimal?      @db.Decimal(5, 2)
  payoutHoldMinutes         Int?
  payoutMethod              PayoutMethod?
  // The vendor as a contact and payout destinations in RazorpayX, created on
  // the first automatic payout; cleared when the bank account or UPI id changes.
  razorpayContactId         String?
  razorpayBankFundAccountId String?
  razorpayUpiFundAccountId  String?
  homeZoneId                String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  // Onboarding: personal details (name, phone, email and city live on User)
  onboardingStatus      VendorOnboardingStatus @default(DRAFT)
  dateOfBirth           DateTime?              @db.Date
  gender                Gender?
  alternatePhone        String?
  addressLine1          String?
  addressLine2          String?
  landmark              String?
  pincode               String?
  state                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  experienceYears       Int?

  // Onboarding: face photo, shown to customers once the vendor is approved
  profilePhotoKey  String?
  profilePhotoMime String?

  // Onboarding: review outcome
  submittedAt  DateTime?
  reviewedAt   DateTime? // when a super admin approved or rejected
  reviewedById String?
  reviewNote   String? // reason for rejection / requested changes, shown to the vendor

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeZone         Zone?                   @relation(fields: [homeZoneId], references: [id])
  reviewedBy       User?                   @relation("ProfessionalReviewer", fields: [reviewedById], references: [id])
  bookings         Booking[]               @relation("ProfessionalBookings")
  documents        ProfessionalDocument[]
  onboardingEvents VendorOnboardingEvent[]
  walletEntries    WalletEntry[]
  payouts          VendorPayout[]

  @@index([homeZoneId])
  @@index([onboardingStatus])
  @@map("professionals")
}

enum KycDocumentType {
  AADHAAR
  PAN
  BANK_ACCOUNT // payout account; the "front" file is a cancelled cheque or passbook page
}

enum BankAccountType {
  SAVINGS
  CURRENT
}

enum KycDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

// One row per document type per vendor (Aadhaar, PAN, payout bank account). The document number is never stored
// in plaintext: `numberEncrypted` is AES-256-GCM (see utils/kycCrypto.js),
// `numberHash` is a keyed hash used only to stop the same Aadhaar/PAN being
// registered on two accounts, and `numberLast4` is what vendors are shown.
model ProfessionalDocument {
  id              String          @id @default(uuid())
  professionalId  String
  type            KycDocumentType
  numberEncrypted String
  numberHash      String
  numberLast4     String
  nameOnDocument  String?
  frontFileKey    String
  frontFileMime   String
  backFileKey     String?
  backFileMime    String?

  // BANK_ACCOUNT only (number* above hold the account number, nameOnDocument the account holder)
  ifsc        String?
  bankName    String?
  branchName  String?
  accountType BankAccountType?
  upiId       String?

  status             KycDocumentStatus @default(PENDING)
  rejectionReason    String?
  // 'MANUAL' when an admin checked it; the provider's name once an automated check is wired in.
  verificationSource String?
  verificationRef    String? // provider's reference/transaction id, if any
  verifiedById       String?
  verifiedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  verifiedBy   User?        @relation("DocumentVerifier", fields: [verifiedById], references: [id])

  @@unique([professionalId, type])
  @@unique([type, numberHash])
  @@map("professional_documents")
}

enum VendorOnboardingAction {
  SUBMITTED
  RESUBMITTED
  DOCUMENT_VERIFIED
  DOCUMENT_REJECTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  REOPENED
}

// Append-only audit trail of everything that happened to an application.
model VendorOnboardingEvent {
  id             String                  @id @default(uuid())
  professionalId String
  actorId        String? // null when the system (e.g. an automated verification) did it
  action         VendorOnboardingAction
  documentType   KycDocumentType?
  fromStatus     VendorOnboardingStatus?
  toStatus       VendorOnboardingStatus?
  note           String?
  createdAt      DateTime                @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  actor        User?        @relation("OnboardingEventActor", fields: [actorId], references: [id])

  @@index([professionalId, createdAt])
  @@map("vendor_onboarding_events")
}

// ---------------------------------------------------------------------------
// Service catalogue
// ---------------------------------------------------------------------------

enum ServiceTier {
  REPAIR
  RENOVATION
  RECURRING
}

model ServiceCategory {
  id        String      @id @default(uuid())
  name      String
  tier      ServiceTier
  basePrice Decimal     @db.Decimal(10, 2)
  // Storage key and type of the picture shown for this service; served from
  // GET /categories/:id/image.
  imageKey  String?
  imageMime String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  bookings Booking[]

  @@map("service_categories")
}

// ---------------------------------------------------------------------------
// Bookings / Dispatch module
// ---------------------------------------------------------------------------

enum BookingStatus {
  AWAITING_PAYMENT // created with online payment chosen; not dispatched until paid
  PENDING // confirmed, waiting for a professional
  MATCHING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMode {
  ONLINE // paid up front through the payment gateway
  PAY_AFTER_SERVICE // collected by the professional once the job is done
}

// Who did something to a booking.
enum BookingActor {
  CUSTOMER
  PROFESSIONAL
  ADMIN
  SYSTEM
}

model Booking {
  id             String        @id @default(uuid())
  // Human-friendly reference shown to customers and support as BK-000123.
  sequence       Int           @unique @default(autoincrement())
  customerId     String
  professionalId String?
  categoryId     String
  status         BookingStatus @default(PENDING)
  scheduledAt    DateTime?
  description    String? // the customer's description of the problem
  paymentMode    PaymentMode   @default(PAY_AFTER_SERVICE)
  price          Decimal?      @db.Decimal(10, 2)

  // Where the job is. Copied from the customer's saved address when the
  // booking is made, so later edits to (or deletion of) that address never
  // change where a booked job takes place.
  address      String // the full address on one line
  addressId    String? // the saved address it came from, if that still exists
  cityId       String?
  zoneId       String?
  pincode      String?
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  contactName  String?
  contactPhone String?

  // Milestones
  assignedAt         DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelledBy        BookingActor?
  cancellationReason String?

  // The job is started and finished with codes the customer reads out to the
  // vendor, so neither can happen without the customer present.
  startOtp                String?
  startOtpAttempts        Int       @default(0)
  completionOtp           String?
  completionOtpAttempts   Int       @default(0)
  completionOtpVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer     User            @relation("CustomerBookings", fields: [customerId], references: [id])
  professional Professional?   @relation("ProfessionalBookings", fields: [professionalId], references: [id])
  category     ServiceCategory @relation(fields: [categoryId], references: [id])
  savedAddress Address?        @relation(fields: [addressId], references: [id], onDelete: SetNull)
  city         City?           @relation(fields: [cityId], references: [id])
  zone         Zone?           @relation(fields: [zoneId], references: [id])
  payment      Payment?
  review       Review?
  partnerId    String?
  partner      Partner?        @relation(fields: [partnerId], references: [id])
  events       BookingEvent[]
  disputes     Dispute[]
  images       BookingImage[]
  walletEntry  WalletEntry?

  @@index([customerId])
  @@index([professionalId])
  @@index([status])
  @@index([scheduledAt])
  @@index([cityId])
  @@map("bookings")
}

enum BookingEventType {
  CREATED
  PAYMENT_RECEIVED
  STATUS_CHANGED
  ASSIGNED
  RESCHEDULED
  CANCELLED
  PAYMENT_COLLECTED
  REFUNDED
}

// Append-only timeline of everything that happened to a booking.
model BookingEvent {
  id         String           @id @default(uuid())
  bookingId  String
  type       BookingEventType
  actorId    String? // null for SYSTEM (e.g. the payment gateway's webhook)
  actorRole  BookingActor
  fromStatus BookingStatus?
  toStatus   BookingStatus?
  note       String?
  createdAt  DateTime         @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User?   @relation("BookingEventActor", fields: [actorId], references: [id])

  @@index([bookingId, createdAt])
  @@map("booking_events")
}

// ---------------------------------------------------------------------------
// AMC module
// ---------------------------------------------------------------------------

enum AMCStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model AMCSubscription {
  id          String    @id @default(uuid())
  customerId  String
  plan        String
  startDate   DateTime
  renewalDate DateTime
  status      AMCStatus @default(ACTIVE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer User      @relation(fields: [customerId], references: [id])
  payments Payment[]

  @@index([customerId])
  @@map("amc_subscriptions")
}

// ---------------------------------------------------------------------------
// Payments module
// ---------------------------------------------------------------------------

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REFUND_PENDING // a paid booking was cancelled; the money has not gone back yet
  REFUNDED
}

model Payment {
  id               String        @id @default(uuid())
  bookingId        String?       @unique
  subscriptionId   String?
  amount           Decimal       @db.Decimal(10, 2)
  method           String? // upi, card, netbanking, wallet...
  gatewayRef       String? // razorpay order/payment id
  gatewayPaymentId String? // razorpay payment id, once paid
  paidAt           DateTime?
  refundedAt       DateTime?
  refundReference  String? // gateway refund id, or a note on how it was refunded
  status           PaymentStatus @default(CREATED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  booking      Booking?         @relation(fields: [bookingId], references: [id])
  subscription AMCSubscription? @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Reviews module
// ---------------------------------------------------------------------------

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Zones module
// ---------------------------------------------------------------------------

enum CityTier {
  TIER_1
  TIER_2
}

model City {
  id        String   @id @default(uuid())
  name      String
  tier      CityTier
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  zones     Zone[]
  users     User[]
  partners  Partner[]
  addresses Address[]
  bookings  Booking[]

  @@map("cities")
}

model Zone {
  id        String   @id @default(uuid())
  cityId    String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  city          City           @relation(fields: [cityId], references: [id])
  professionals Professional[]
  addresses     Address[]
  bookings      Booking[]

  @@index([cityId])
  @@map("zones")
}

// ---------------------------------------------------------------------------
// Partners module
// ---------------------------------------------------------------------------

enum PartnerType {
  BUILDER
  RWA
}

model Partner {
  id        String      @id @default(uuid())
  type      PartnerType
  name      String
  cityId    String
  contact   String?
  createdAt DateTime    @default(now())

  city     City      @relation(fields: [cityId], references: [id])
  bookings Booking[]

  @@index([cityId])
  @@map("partners")
}

// ---------------------------------------------------------------------------
// Help & disputes: a customer or vendor asks for help or raises a dispute,
// optionally about one booking, and talks it through with the support team.
// ---------------------------------------------------------------------------

enum DisputeType {
  HELP // a question or a request for assistance
  DISPUTE // a complaint that needs a decision
}

enum DisputeCategory {
  BOOKING
  PAYMENT
  REFUND
  SERVICE_QUALITY
  PROFESSIONAL_BEHAVIOUR
  CUSTOMER_BEHAVIOUR
  PAYOUT
  ACCOUNT
  APP_ISSUE
  OTHER
}

enum DisputeStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum DisputePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Dispute {
  id           String          @id @default(uuid())
  // Human-friendly reference shown in the apps and to support as DSP-000123.
  sequence     Int             @unique @default(autoincrement())
  raisedById   String
  raisedByRole BookingActor // CUSTOMER or PROFESSIONAL
  type         DisputeType     @default(DISPUTE)
  category     DisputeCategory
  bookingId    String?
  subject      String
  description  String
  status       DisputeStatus   @default(OPEN)
  priority     DisputePriority @default(NORMAL)
  assignedToId String?
  resolution   String? // what was decided, shown to the person who raised it
  resolvedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  raisedBy   User             @relation("DisputeRaiser", fields: [raisedById], references: [id])
  assignedTo User?            @relation("DisputeAssignee", fields: [assignedToId], references: [id])
  booking    Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  messages   DisputeMessage[]

  @@index([raisedById, createdAt])
  @@index([status, createdAt])
  @@index([bookingId])
  @@map("disputes")
}

model DisputeMessage {
  id         String       @id @default(uuid())
  disputeId  String
  authorId   String?
  authorRole BookingActor // CUSTOMER, PROFESSIONAL or ADMIN
  body       String
  createdAt  DateTime     @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id])

  @@index([disputeId, createdAt])
  @@map("dispute_messages")
}

// Photos of the finished work, uploaded by the vendor before completing a job.
model BookingImage {
  id           String   @id @default(uuid())
  bookingId    String
  fileKey      String
  mimeType     String
  uploadedById String?
  createdAt    DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_images")
}

// ---------------------------------------------------------------------------
// Vendor wallet. Completing a job credits the vendor (an EARNING). It is held
// for a few days, then becomes ready, and is settled when the team sends the
// money to the vendor's bank account (a PAYOUT, which marks those earnings PAID).
// ---------------------------------------------------------------------------

enum WalletEntryType {
  EARNING // money owed to the vendor for a completed job
  PAYOUT // money sent to the vendor's bank account
}

enum WalletEntryStatus {
  PENDING // an earning not sent yet: on hold until availableAt, ready after it
  PAID // an earning that has been sent, or the payout that sent it
  SETTLED_IN_CASH // the vendor took the customer's cash themselves; nothing to send
}

model WalletEntry {
  id             String            @id @default(uuid())
  professionalId String
  type           WalletEntryType
  status         WalletEntryStatus @default(PENDING)
  amount         Decimal           @db.Decimal(10, 2) // what the vendor gets (earning) or was sent (payout); always positive
  grossAmount    Decimal?          @db.Decimal(10, 2) // earning: what the customer was charged
  commission     Decimal?          @db.Decimal(10, 2) // earning: the platform's share
  bookingId      String?           @unique // earning: the job it is for
  availableAt    DateTime? // earning: when the hold ends
  payoutId       String? // earning: the payout that settled it; payout: its own record
  note           String?
  createdAt      DateTime          @default(now())

  professional Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  booking      Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  payout       VendorPayout? @relation(fields: [payoutId], references: [id])

  @@index([professionalId, createdAt])
  @@index([professionalId, type, status])
  @@map("wallet_entries")
}

model VendorPayout {
  id               String       @id @default(uuid())
  // Human-friendly reference shown to vendors and the team as PO-000123.
  sequence         Int          @unique @default(autoincrement())
  professionalId   String
  amount           Decimal      @db.Decimal(10, 2)
  reference        String // the bank / UPI transaction reference
  method           PayoutMethod @default(BANK_TRANSFER)
  // MANUAL: the team sent the money and recorded it. AUTOMATIC: sent through
  // the payout provider (on schedule, or with "Send now").
  mode             PayoutMode   @default(MANUAL)
  status           PayoutStatus @default(PAID)
  providerPayoutId String? // the provider's payout id
  failureReason    String?
  processedAt      DateTime?
  note             String?
  paidAt           DateTime     @default(now())
  createdById      String?
  createdAt        DateTime     @default(now())

  professional Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  entries      WalletEntry[]

  @@index([professionalId, createdAt])
  @@map("vendor_payouts")
}

// How vendors are paid out, and the platform's defaults. One row (id 1),
// edited by a super admin from the dashboard. A vendor can have their own
// commission, hold period and method (columns on Professional).
enum PayoutMethod {
  BANK_TRANSFER // NEFT / IMPS / RTGS to the vendor's bank account
  UPI // to the vendor's UPI id
  CASH // handed over in person
}

enum PayoutFrequency {
  AFTER_HOLD // pay each earning as soon as its hold ends
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model PayoutSettings {
  id                 Int             @id @default(1)
  holdMinutes        Int             @default(2880) // 2 days
  commissionPercent  Decimal         @default(0) @db.Decimal(5, 2)
  payoutMethod       PayoutMethod    @default(BANK_TRANSFER)
  frequency          PayoutFrequency @default(AFTER_HOLD)
  // The first scheduled payout day; later ones repeat from it (weekly, every
  // two weeks, or monthly on the same day of the month).
  firstPayoutDate    DateTime?       @db.Date
  // Send ready earnings through the payout provider without anyone pressing a button.
  automaticPayouts   Boolean         @default(false)
  lastAutomaticRunOn DateTime?       @db.Date
  updatedById        String?
  updatedAt          DateTime        @updatedAt

  @@map("payout_settings")
}

enum PayoutMode {
  MANUAL
  AUTOMATIC
}

enum PayoutStatus {
  PROCESSING // handed to the provider, not confirmed yet
  PAID
  FAILED // the provider could not send it; the earnings are owed again
}
