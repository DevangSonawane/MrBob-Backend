# App
NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1

# Database (Postgres). Locally this matches docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/home_services_dev?schema=public

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated list of allowed origins (one per frontend app), or "*" for any
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase (Cloud Messaging + presence)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Maps
GOOGLE_MAPS_API_KEY=

# WhatsApp Business API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Cloudflare R2 (media storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Temporary: fixed 4-digit OTP for every login while no SMS/WhatsApp provider is connected.
# Leave empty to generate random OTPs. Remove before going live with real users.
OTP_STATIC_CODE=

# Vendor KYC
# 32-byte key for encrypting Aadhaar/PAN numbers. Generate with: openssl rand -base64 32
# Required in production; dev/test fall back to a fixed insecure key.
KYC_ENCRYPTION_KEY=
# Who verifies Aadhaar/PAN documents. "manual" = an admin checks them in the dashboard.
KYC_VERIFICATION_PROVIDER=manual
# Local folder for uploaded documents when R2 is not configured (dev/test only)
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info
