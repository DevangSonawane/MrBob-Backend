# App
NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1

# Database (Postgres). Locally this matches docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/home_services_dev?schema=public

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated list of allowed origins (one per frontend app), or "*" for any
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase Cloud Messaging (push notifications). From Firebase console → Project settings →
# Service accounts → Generate new private key: project_id, client_email and private_key from that
# JSON file. Paste the private key on one line with \n for the line breaks. Without these, push
# notifications are written to the server log instead of sent.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Booking assistant: Claude reads the customer's description of the problem (typed, or spoken and
# turned into text by the phone) and drafts the booking. From console.anthropic.com → API keys.
# Without it the assistant is switched off and the app picks the service by hand.
ANTHROPIC_API_KEY=

# Google Maps
GOOGLE_MAPS_API_KEY=

# WhatsApp Business API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Cloudflare R2 (media storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Email + password the seed gives the bootstrap super admin, for signing in to the admin
# dashboard. Only read by `npm run seed`. Use a strong password; re-run the seed to change it.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# Temporary: fixed 4-digit OTP for every login while no SMS/WhatsApp provider is connected.
# Leave empty to generate random OTPs. Remove before going live with real users.
OTP_STATIC_CODE=

# Temporary: "off" makes customer and vendor onboarding accept any input while the apps are
# being built (only the OTP is checked: 4 digits, and correct). Set to "strict" to enforce
# every rule (formats, required fields, age, Aadhaar/PAN/IFSC checks, file types, duplicate
# checks). Use "strict" before real users sign up.
ONBOARDING_VALIDATION=off

# Pincode geofence. "strict": customers (and the team) can only book at an address whose
# pincode is in the serviceable list (Dashboard → Service coverage → Pincodes). "off": any
# address can be booked, but addresses still say whether they are serviceable. Add your
# pincodes first, then switch to "strict".
PINCODE_GEOFENCE=off

# Vendor KYC
# 32-byte key for encrypting Aadhaar/PAN numbers. Generate with: openssl rand -base64 32
# Required in production; dev/test fall back to a fixed insecure key.
KYC_ENCRYPTION_KEY=
# Who verifies Aadhaar/PAN documents. "manual" = an admin checks them in the dashboard.
KYC_VERIFICATION_PROVIDER=manual
# Local folder for uploaded documents when R2 is not configured (dev/test only)
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info

# Vendor wallet: days an earning is held after a job is completed before it is ready to be
# paid out, and the platform's share of each job (percent). Defaults: 2 and 0.
PAYOUT_HOLD_DAYS=2
PLATFORM_COMMISSION_PERCENT=0
